{
  "name": "qscriptions",
  "version": "0.0.0-canary.0",
  "description": "Dependency-free, byte-exact verification for frozen QPET inscriptions on Qbit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djh58/qscriptions.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/djh58/qscriptions/issues"
  },
  "homepage": "https://github.com/djh58/qscriptions#readme",
  "keywords": [
    "qbit",
    "qpet",
    "qscriptions",
    "op-return",
    "inscription",
    "verification"
  ]
}
